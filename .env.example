# Server Configuration
DATABASE_URL=sqlite:///./dev.db
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Firebase Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-firebase-storage-bucket
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Tavily Search API — real-time research for agents (tavily.com)
TAVILY_API_KEY=your-tavily-api-key

# Groq LLM API — fast inference for text/JSON generation (console.groq.com)
GROQ_API_KEY=your-groq-api-key

# Gemini Vision API — for sketch/image analysis (ai.google.dev)
GEMINI_API_KEY=your-gemini-api-key

# Demo Mode (set true to bypass credential checks)
DEMO_MODE=false